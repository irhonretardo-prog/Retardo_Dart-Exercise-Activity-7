void main() {
  // 1. Declare variables with explicit types
  String customerName = 'Irhon Clark A. Retardo';
  int coffeeCount = 1;
  double pricePerCup = 2.75;
  bool appliesForDiscount = true;

  // 2. Arithmetic operators (including extra credit: ~/ and %)
  double rawTotal = coffeeCount * pricePerCup;
  int wholeDollarAmount = rawTotal ~/ 1; // Extra Credit: Integer division
  int freeStampRemainder = coffeeCount % 3; // Extra Credit: Modulo operator

  // 3. Comparison operators (produces bool)
  bool qualifiesForFreeCookie = rawTotal >= 15.0;
  bool getsMemberPerk = appliesForDiscount && qualifiesForFreeCookie;

  // 4. Output with String interpolation
  print('Customer Name: $customerName');
  print('Total Price: \$${rawTotal.toStringAsFixed(2)}');
  print('Whole Dollars Spent: \$$wholeDollarAmount');
  print('Loyalty Stamp Progress: $freeStampRemainder cup(s) towards next reward');
  print('Qualifies for Free Cookie? $qualifiesForFreeCookie');
  print('Eligible for Member Perk? $getsMemberPerk');
}
